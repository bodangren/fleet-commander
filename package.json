{
  "name": "fleet-commander",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["pivot", "frontend"],
  "dependencies": {
    "convex": "^1.40.0"
  },
  "scripts": {
    "test": "bun run --cwd pivot test",
    "lint": "cd frontend && npm run lint",
    "build": "cd frontend && npm run build",
    "dev": "concurrently --names \"convex,pivot,frontend\" --prefix-colors \"cyan,yellow,green\" \"npx convex dev\" \"bun run --cwd pivot dev\" \"npm run frontend:dev\"",
    "pivot:dev": "bun run --cwd pivot dev",
    "pivot:start": "bun run --cwd pivot start",
    "pivot:test": "bun run --cwd pivot test",
    "frontend:dev": "cd frontend && npm run dev",
    "convex:codegen": "npx convex codegen --init",
    "verify": "bash measure/verify.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.0"
  },
  "resolutions": {
    "js-yaml": "4.2.0",
    "fast-uri": ">=3.1.2",
    "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
    "postcss": ">=8.5.10",
    "brace-expansion": ">=5.0.6",
    "ws": ">=8.20.1"
  }
}
